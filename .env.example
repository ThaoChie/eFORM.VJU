# PostgreSQL Database
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/edrl_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password123

# JWT Security
JWT_SECRET=super_secret_jwt_key_drl_eform_2026_super_secret_jwt_key_drl_eform_2026
JWT_EXPIRATION_MS=28800000

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PROOFS=proofs
MINIO_BUCKET_SIGNATURES=signatures
MINIO_BUCKET_SIGNED_PDFS=signed-pdfs

# Python Render Service
RENDER_SERVICE_URL=http://word-parser:8000/render
RENDER_TIMEOUT_MS=30000

# Keystore
KEYSTORE_PATH=classpath:keystore.p12
KEYSTORE_PASSWORD=keystorepassword
KEY_ALIAS=edrl_alias

# CORS & Public URL
PUBLIC_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
